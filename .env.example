# Public Supabase client settings -- same shared TaskLocal project the other
# three products use. Safe to expose to the browser (Row Level Security
# enforces access, not this key).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-side only -- do NOT prefix with VITE_. A VITE_-prefixed var gets
# bundled into the client-side JS and would be visible to anyone who opens
# dev tools. This one is read only by api/chat.js, which runs as a Vercel
# serverless function, never in the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key
